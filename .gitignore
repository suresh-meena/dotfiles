# This repository is intentionally safe to publish.

# Machine-specific dotfiles stay ordinary local files and are never committed.
/personal/*
!/personal/README.md

# Local secrets and credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
credentials/
secrets/
.password-store/
.ssh/
.gnupg/

# Runtime state from local tools.
.codex/
.opencode/
.config/fleet/
.config/opencode/

# Shell/editor history and caches.
.bash_history*
.zsh_history*
.zcompdump*
history*
.cache/
*.log
*.tmp
*~

# OS/editor noise.
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]

# modelctl runtime state.
.modelctl/
*.egg-info/

# Research KB local state (routing .research/project.toml is committed; the database stays local).
**/.research/state/
**/.research/spool/
**/research-exports/

# Supplied site document contains private connection details.
/sureshproblem/AMD Server.pdf

# Supplied KIAC site manual contains private connection details.
/slurm-helper/Instructions and guidelines.pdf

# slurm-helper self-learning runtime state (raw evidence log; applied facts live in config/kiac.yaml).
/slurm-helper/skills/slurm-helper/var/
