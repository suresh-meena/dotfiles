#!/usr/bin/env bash
set -euo pipefail

# Build each virtual environment at its final path. Only current is switched
# atomically because virtualenv entrypoint shebangs are absolute.
usage() {
  echo 'usage: install-hub [--dry-run] [--replace] [--python PYTHON] [--source DIR] [--yes-i-know-lingering-is-off]' >&2
}
dry_run=0
replace=0
linger_ack=0
python_override=${FLEETMON_PYTHON:-}
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
while (($#)); do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --replace) replace=1 ;;
    --yes-i-know-lingering-is-off) linger_ack=1 ;;
    --python) shift; (($#)) || { echo '--python requires a value' >&2; exit 2; }; python_override=$1 ;;
    --source) shift; (($#)) || { echo '--source requires a value' >&2; exit 2; }; source_dir=$(cd -- "$1" 2>/dev/null && pwd -P) || { echo "source directory is not accessible: $1" >&2; exit 2; } ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
  esac
  shift
done
[[ -f "$source_dir/pyproject.toml" ]] || { echo "source has no pyproject.toml: $source_dir" >&2; exit 2; }
[[ -f "$source_dir/packaging/fleetmon-hub.service" ]] || { echo 'source has no service unit' >&2; exit 2; }
[[ -f "$source_dir/requirements-hub.lock" ]] || { echo 'source has no requirements-hub.lock' >&2; exit 2; }

version_ok() {
  local executable=$1 major minor
  read -r major minor < <("$executable" -c 'import sys; print(sys.version_info[0], sys.version_info[1])' 2>/dev/null) || return 1
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  (( major > 3 || (major == 3 && minor >= 10) ))
}
python_cmd=()
if [[ -n "$python_override" ]]; then
  command -v "$python_override" >/dev/null 2>&1 || [[ -x "$python_override" ]] || { echo "Python executable was not found: $python_override" >&2; exit 2; }
  version_ok "$python_override" || { echo "Python 3.10+ is required: $python_override" >&2; exit 2; }
  python_cmd=("$python_override")
else
  for candidate in python3.10 python3.11 python3.12 python3.13 python3.14 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && version_ok "$candidate"; then python_cmd=("$candidate"); break; fi
  done
  ((${#python_cmd[@]})) || { echo 'no Python 3.10+ interpreter found (set FLEETMON_PYTHON)' >&2; exit 2; }
fi

install_root=${FLEETMON_INSTALL_ROOT:-"$HOME/.local/share/fleetmon"}
unit_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user
unit_path="$unit_dir/fleetmon-hub.service"
current_path="$install_root/current"
releases_dir="$install_root/releases"
state_dir="$HOME/.local/state/fleetmon"
fleet_state_dir="$HOME/.local/state/fleet"
fleet_cache_dir="$HOME/.cache/fleet"
[[ "$install_root" == "$HOME/.local/share/fleetmon" ]] || { echo "FLEETMON_INSTALL_ROOT must be $HOME/.local/share/fleetmon" >&2; exit 2; }
[[ "$unit_dir" == "$HOME/.config/systemd/user" ]] || { echo 'XDG_CONFIG_HOME must be $HOME/.config for this installer' >&2; exit 2; }
[[ ! -L "$install_root" ]] || { echo "install root must not be a symlink: $install_root" >&2; exit 2; }
[[ ! -L "$unit_dir" ]] || { echo "unit directory must not be a symlink: $unit_dir" >&2; exit 2; }
[[ ! -L "$releases_dir" ]] || { echo "releases directory must not be a symlink: $releases_dir" >&2; exit 2; }

# Every component below HOME is user-owned and must be a real directory. In
# particular, checking only the leaf is insufficient: ~/.config or
# ~/.local/share could itself be a symlink to an attacker-controlled tree.
check_destination_chain() {
  local path=$1 label=$2 component current rest owner mode
  [[ "$HOME" == /* && "$HOME" != */ && -d "$HOME" && ! -L "$HOME" ]] || {
    echo "HOME must be an absolute, real directory without a trailing slash: $HOME" >&2
    exit 2
  }
  read -r owner mode < <(stat -c '%u %a' -- "$HOME") || {
    echo "could not inspect HOME: $HOME" >&2
    exit 2
  }
  [[ "$owner" == "$EUID" && "$mode" =~ ^[0-7]+$ ]] || {
    echo "HOME is not owned by the current user: $HOME" >&2
    exit 2
  }
  (( (8#$mode & 0022) == 0 )) || {
    echo "HOME is writable by another user: $HOME" >&2
    exit 2
  }
  current=$HOME
  rest=${path#"$HOME"/}
  while [[ -n "$rest" ]]; do
    if [[ "$rest" == */* ]]; then
      component=${rest%%/*}
      rest=${rest#*/}
    else
      component=$rest
      rest=
    fi
    current="$current/$component"
    [[ ! -L "$current" ]] || {
      echo "$label contains a symlink: $current" >&2
      exit 2
    }
    if [[ -e "$current" ]]; then
      [[ -d "$current" ]] || {
        echo "$label path component is not a directory: $current" >&2
        exit 2
      }
      read -r owner mode < <(stat -c '%u %a' -- "$current") || {
        echo "could not inspect $label path component: $current" >&2
        exit 2
      }
      [[ "$owner" == "$EUID" && "$mode" =~ ^[0-7]+$ ]] || {
        echo "$label path component is not owned by the current user: $current" >&2
        exit 2
      }
      (( (8#$mode & 0022) == 0 )) || {
        echo "$label path component is writable by another user: $current" >&2
        exit 2
      }
    fi
  done
}

check_destination_chain "$install_root" 'install root'
check_destination_chain "$unit_dir" 'unit directory'
check_destination_chain "$state_dir" 'hub state directory'
check_destination_chain "$fleet_state_dir" 'fleet state directory'
check_destination_chain "$fleet_cache_dir" 'fleet cache directory'

[[ ! -L "$unit_path" ]] || { echo "unit path must not be a symlink: $unit_path" >&2; exit 2; }
[[ ! -L "$releases_dir" ]] || { echo "releases directory must not be a symlink: $releases_dir" >&2; exit 2; }
if [[ -e "$install_root" && ! -d "$install_root" ]]; then
  echo "install root is not a directory: $install_root" >&2
  exit 2
fi
if [[ -e "$releases_dir" && ! -d "$releases_dir" ]]; then
  echo "releases path is not a directory: $releases_dir" >&2
  exit 2
fi
if [[ -e "$unit_dir" && ! -d "$unit_dir" ]]; then
  echo "unit directory is not a directory: $unit_dir" >&2
  exit 2
fi
if [[ -e "$unit_path" && ! -f "$unit_path" ]]; then
  echo "unit path is not a regular file: $unit_path" >&2
  exit 2
fi
if [[ -e "$current_path" && ! -L "$current_path" ]]; then
  echo "current activation path must be a symlink or absent: $current_path" >&2
  exit 2
fi

old_current_state=absent
old_current_target=
if [[ -L "$current_path" ]]; then
  old_current_target=$(readlink -- "$current_path")
  old_current_link_path=$old_current_target
  [[ "$old_current_link_path" == /* ]] || old_current_link_path="$install_root/$old_current_link_path"
  case "$old_current_link_path" in
    "$releases_dir"/*) ;;
    *) echo "current activation symlink does not point into releases directory" >&2; exit 2 ;;
  esac
  old_current_resolved=$(readlink -f -- "$current_path") || {
    echo "current activation symlink is not resolvable: $current_path" >&2
    exit 2
  }
  [[ -d "$old_current_resolved" ]] || {
    echo "current activation target is not a directory: $current_path" >&2
    exit 2
  }
  case "$old_current_resolved/" in
    "$releases_dir"/*) ;;
    *) echo "current activation target escapes releases directory" >&2; exit 2 ;;
  esac
  old_current_relative=${old_current_resolved#"$releases_dir"/}
  [[ -n "$old_current_relative" && "$old_current_relative" != */* ]] || {
    echo "current activation target must be one release directory" >&2
    exit 2
  }
  old_current_state=symlink
fi

# A previous release plus an existing database makes this an upgrade: a schema
# backup must run before current is switched. A database_path override in the
# documented configuration also counts as existing state.
is_upgrade=0
if [[ "$old_current_state" == symlink ]]; then
  if [[ -f "$state_dir/fleet.db" || -e "$state_dir/fleet.db-wal" ]]; then
    is_upgrade=1
  elif [[ -f "${FLEETMON_CONFIG:-$HOME/.config/fleetmon/config.toml}" ]] && grep -qs 'database_path' -- "${FLEETMON_CONFIG:-$HOME/.config/fleetmon/config.toml}"; then
    is_upgrade=1
  fi
fi

python_display=$("${python_cmd[@]}" --version 2>&1)
if ((dry_run)); then
  printf 'dry-run: source=%s\n' "$source_dir"
  printf 'dry-run: python=%s (%s)\n' "${python_cmd[*]}" "$python_display"
  printf 'dry-run: would create final-path venv under %s/releases/<timestamp>/venv\n' "$install_root"
  printf 'dry-run: would install requirements-hub.lock, then install project with --no-deps\n'
  printf 'dry-run: would create %s, %s, and %s\n' "$state_dir" "$fleet_state_dir" "$fleet_cache_dir"
  printf 'dry-run: would atomically switch %s before replacing the user unit\n' "$current_path"
  printf 'dry-run: would place user unit at %s; would not enable or start it\n' "$unit_path"
  printf 'dry-run: would verify systemd user lingering via loginctl; the hub survives logout only with lingering\n'
  exit 0
fi
if [[ -e "$install_root" && $replace -eq 0 ]]; then echo "install exists: $install_root (use --replace)" >&2; exit 3; fi
if [[ -e "$unit_path" && $replace -eq 0 ]]; then echo "unit exists: $unit_path (use --replace)" >&2; exit 3; fi
command -v systemctl >/dev/null 2>&1 || { echo 'systemctl is required' >&2; exit 3; }
systemctl --user show-environment >/dev/null 2>&1 || { echo 'systemd user manager is not reachable; refusing to install' >&2; exit 3; }

# The hub is a systemd --user service. It survives logout only while the user
# manager lingers, so persistence must be verified explicitly instead of implied.
linger_confirmed=0
if command -v loginctl >/dev/null 2>&1; then
  linger_output=$(loginctl show-user "$UID" --property=Linger 2>/dev/null || true)
  [[ "$linger_output" == *'Linger=yes'* ]] && linger_confirmed=1
  [[ "$linger_confirmed" == 1 ]] || echo 'systemd user lingering is not enabled for this user' >&2
else
  echo 'loginctl was not found; systemd user lingering could not be verified' >&2
fi
if [[ "$linger_confirmed" == 0 ]]; then
  cat >&2 <<EOF
Without lingering the systemd --user hub service will NOT survive logout.
Fleetmon must not claim logout persistence until this is fixed.
Administrator step: sudo loginctl enable-linger ${USER:-$(id -un)}
Rerun with --yes-i-know-lingering-is-off to install anyway with logout persistence off.
EOF
  [[ "$linger_ack" == 1 ]] || exit 3
fi

mkdir -p -- "$releases_dir" "$unit_dir" "$state_dir" "$fleet_state_dir" "$fleet_cache_dir"
chmod 700 "$install_root" "$releases_dir" "$state_dir" "$fleet_state_dir" "$fleet_cache_dir"
release_id=$(date +%Y%m%d%H%M%S)-$$
release_dir="$releases_dir/$release_id"
mkdir -- "$release_dir"
committed=0
current_tmp=
unit_tmp=
rollback_needed=0
restore_current() {
  local rollback_tmp
  if [[ "$old_current_state" == absent ]]; then
    rm -f -- "$current_path"
    return
  fi
  rollback_tmp="$install_root/.rollback-current.$release_id"
  rm -f -- "$rollback_tmp"
  ln -s -- "$old_current_target" "$rollback_tmp" &&
    mv -Tf -- "$rollback_tmp" "$current_path"
}
cleanup() {
  local status=$?
  set +e
  [[ -z "$current_tmp" ]] || rm -f -- "$current_tmp"
  [[ -z "$unit_tmp" ]] || rm -f -- "$unit_tmp"
  if ((rollback_needed)); then
    if restore_current; then
      rollback_needed=0
      rm -rf -- "$release_dir"
    else
      echo "CRITICAL: could not restore previous current activation; release retained at $release_dir" >&2
    fi
  elif ((committed == 0)); then
    rm -rf -- "$release_dir"
  fi
  return "$status"
}
trap cleanup EXIT

# Never move a venv after creation: pip-generated script shebangs are absolute.
"${python_cmd[@]}" -m venv "$release_dir/venv"
"$release_dir/venv/bin/python" -m pip install --disable-pip-version-check -r "$source_dir/requirements-hub.lock"
"$release_dir/venv/bin/python" -m pip install --disable-pip-version-check --no-deps "$source_dir"
"$release_dir/venv/bin/fleetmon" --help >/dev/null

# On an upgrade the staged CLI must take the schema backup itself, before any
# activation. Aborting here removes only the staged release: old current and
# the old unit stay runnable.
if ((is_upgrade)); then
  if ! backup_json=$("$release_dir/venv/bin/fleetmon" maintain backup --state-dir "$state_dir"); then
    echo 'fleetmon maintain backup failed before upgrade; aborting without switching current' >&2
    exit 1
  fi
  backup_path=$(printf '%s' "$backup_json" | "$release_dir/venv/bin/python" -c '
import json
import sys

try:
    value = json.load(sys.stdin)
except ValueError:
    raise SystemExit(1)
if not isinstance(value, dict) or value.get("ok") is not True:
    raise SystemExit(1)
backup_path = value.get("path")
if not isinstance(backup_path, str) or not backup_path:
    raise SystemExit(1)
print(backup_path)
') || {
    echo 'fleetmon maintain backup did not report ok; aborting without switching current' >&2
    printf '%s\n' "$backup_json" >&2
    exit 1
  }
  printf 'schema backup created before upgrade: %s\n' "$backup_path"
fi

# A valid release exists before activation. If unit replacement fails, the old
# unit remains runnable; this new release/current pair is also runnable.
current_tmp="$install_root/.current.$release_id"
ln -s -- "$release_dir" "$current_tmp"
mv -Tf -- "$current_tmp" "$current_path"
current_tmp=
rollback_needed=1
unit_tmp=$(mktemp "$unit_dir/.fleetmon-hub.service.XXXXXX")
install -m 0644 "$source_dir/packaging/fleetmon-hub.service" "$unit_tmp"
mv -f -- "$unit_tmp" "$unit_path"
unit_tmp=
committed=1
rollback_needed=0
trap - EXIT
cat <<EOF
Fleetmon hub installed at $current_path.
Release stored at $release_dir.
Unit installed at $unit_path.
Review the unit, then run:
  systemctl --user daemon-reload
  systemctl --user enable --now fleetmon-hub.service
EOF
if [[ "$linger_confirmed" == 1 ]]; then
  printf 'User lingering is enabled; the hub service survives logout.\n'
else
  printf 'WARNING: user lingering is not enabled; the hub will NOT survive logout.\n'
  printf 'Administrator step: sudo loginctl enable-linger %s\n' "${USER:-$(id -un)}"
fi
