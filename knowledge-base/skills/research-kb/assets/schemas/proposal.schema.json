{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-kb.local/schemas/proposal.schema.json",
  "title": "Proposal request",
  "description": "Offline starter contract for an rkb_propose request. Passing this check is not permission to bypass server-side validation, authorization, or concurrency checks.",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["op", "payload"],
        "properties": {
          "op": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "expected_revision": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "reason": { "type": ["string", "null"], "maxLength": 2000 },
    "request_id": { "type": ["string", "null"], "maxLength": 200 },
    "persist": { "type": "boolean" },
    "auto_apply": { "type": "boolean" }
  },
  "additionalProperties": false
}
