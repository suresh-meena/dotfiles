{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "modelctl config v1",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup_timeout_s": { "type": "integer", "minimum": 1 },
        "graceful_stop_timeout_s": { "type": "integer", "minimum": 1 },
        "kill_timeout_s": { "type": "integer", "minimum": 1 },
        "cleanup_verify_timeout_s": { "type": "integer", "minimum": 1 },
        "bind_host": { "type": "string", "enum": ["127.0.0.1", "::1"] },
        "access": { "type": "string", "enum": ["tunnel"] },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["persistent", "ttl", "session"] },
            "ttl_s": { "type": "integer", "minimum": 1 },
            "lease_grace_s": { "type": "integer", "minimum": 1 }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_logging": { "type": "boolean" },
            "output_logging": { "type": "boolean" },
            "allow_remote_exposure": { "type": "boolean" },
            "state_file_mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
            "state_dir_mode": { "type": "string", "pattern": "^0[0-7]{3}$" }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "gpu_memory_utilization": { "type": "number", "minimum": 0.1, "maximum": 1.0 }
      }
    },
    "machines": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ssh": {
              "type": "object",
              "required": ["host"],
              "additionalProperties": false,
              "properties": {
                "host": { "type": "string", "minLength": 1 },
                "user": { "type": "string" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "password_file": { "type": "string" }
              }
            },
            "supervisor": { "type": "string", "enum": ["systemd-user"] },
            "inventory": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "roots": { "type": "array", "items": { "type": "string" } },
                "max_age_before_start_s": { "type": "integer", "minimum": 0 },
                "auto_refresh_before_start": { "type": "boolean" }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["venv", "container", "system"] },
                "activate": { "type": "string" },
                "image": { "type": "string" }
              }
            },
            "gpu": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sharing": { "type": "string", "enum": ["exclusive-managed", "shared"] },
                "require_same_user_for_foreign_processes": { "type": "boolean" }
              }
            },
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "gpu_memory_utilization": { "type": "number", "minimum": 0.1, "maximum": 1.0 }
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "served_model_name": { "type": "string" },
            "family": { "type": "string" },
            "generation_config": { "type": "string", "enum": ["vllm"] }
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "patternProperties": {
        "^.+@.+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "machine": { "type": "string" },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "require_observed": { "type": "boolean" }
              },
              "required": ["path"]
            },
            "gpus": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "type": "string", "enum": ["persistent", "ttl", "session"] },
                "ttl_s": { "type": "integer", "minimum": 1 },
                "lease_grace_s": { "type": "integer", "minimum": 1 }
              }
            },
            "security": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allow_remote_exposure": { "type": "boolean" },
                "network_policy": { "type": "string" }
              }
            },
            "tunnel": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "local_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "vllm": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tensor_parallel_size": { "type": "integer", "minimum": 1 },
                "max_model_len": { "type": "integer", "minimum": 1 },
                "gpu_memory_utilization": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
                "dtype": { "type": "string" },
                "extra_args": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "required": ["model", "machine", "artifact"]
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "brain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": { "type": "string", "enum": ["codex"] },
            "final_authority": { "type": "boolean" },
            "authority": { "type": "string" },
            "labels": { "type": "array", "items": { "type": "string" } }
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["opencode"] },
            "executable": { "type": "string" },
            "provider": { "type": "string" },
            "model": { "type": "string" }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "driver": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "backend": { "type": "string" },
                "model": { "type": "string" },
                "variant": { "type": "string" },
                "max_parallel": { "type": "integer", "minimum": 1 },
                "max_files_read": { "type": "integer", "minimum": 1 },
                "max_files_write": { "type": "integer", "minimum": 0 },
                "max_patch_lines": { "type": "integer", "minimum": 1 },
                "default_timeout_s": { "type": "integer", "minimum": 1 },
                "workspace": { "type": "string" },
                "validation": { "type": "string" }
              }
            },
            "worker": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "backend": { "type": "string" },
                "model": { "type": "string" },
                "variant": { "type": "string" },
                "max_parallel": { "type": "integer", "minimum": 1 },
                "max_files_read": { "type": "integer", "minimum": 1 },
                "max_files_write": { "type": "integer", "minimum": 0 },
                "max_patch_lines": { "type": "integer", "minimum": 1 },
                "default_timeout_s": { "type": "integer", "minimum": 1 },
                "workspace": { "type": "string" },
                "validation": { "type": "string" }
              }
            }
          }
        },
        "orchestration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_total_parallel": { "type": "integer", "minimum": 1 },
            "max_task_depth": { "type": "integer", "minimum": 0 },
            "max_task_fanout": { "type": "integer", "minimum": 1 },
            "worker_batch_size": { "type": "integer", "minimum": 1 },
            "worker_return_tokens": { "type": "integer", "minimum": 1 },
            "driver_return_tokens": { "type": "integer", "minimum": 1 },
            "aggregate_return_tokens": { "type": "integer", "minimum": 1 },
            "require_structured_results": { "type": "boolean" },
            "recursive_delegation": { "type": "boolean" },
            "fail_fast": { "type": "boolean" },
            "overlap_policy": { "type": "string", "enum": ["serialize", "allow_disjoint"] }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pure_mode": { "type": "boolean" },
            "auto_approve": { "type": "boolean" },
            "auto_update": { "type": "boolean" },
            "provider_allowlist": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "run_timeout_s": { "type": "integer", "minimum": 1 },
            "graceful_cancel_timeout_s": { "type": "integer", "minimum": 1 },
            "cleanup_timeout_s": { "type": "integer", "minimum": 1 }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_diff_capture": { "type": "boolean" },
            "reject_out_of_scope_changes": { "type": "boolean" },
            "run_declared_tests": { "type": "boolean" }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel_total": { "type": "integer", "minimum": 1 },
        "max_parallel_worker": { "type": "integer", "minimum": 1 },
        "max_parallel_driver": { "type": "integer", "minimum": 1 },
        "max_task_fanout": { "type": "integer", "minimum": 1 },
        "max_retry_per_candidate": { "type": "integer", "minimum": 0 },
        "max_escalations": { "type": "integer", "minimum": 0 },
        "soft_daily_usd": { "type": "number", "minimum": 0 },
        "hard_daily_usd": { "type": "number", "minimum": 0 },
        "go_usage_value": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
